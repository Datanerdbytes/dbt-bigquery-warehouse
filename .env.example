NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AUTH_APP_ORIGIN=http://localhost:8050
AUTH_ALLOWED_EMAILS=

# Google Cloud Platform (production GCP project ID required)
GCP_PROJECT_ID=
# GCP_KEY_PATH=/path/to/gcp-key.json  # Optional: server-side service account key

# SQL Server credentials (bronze layer)
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Directory containing the source CSV files; example: /data/source
SOURCE_FOLDER=
# SQLAlchemy SQL Server URL using ODBC Driver 18; use URL-encoded credentials.
# Example format: mssql+pyodbc://<user>:<password>@localhost:1433/<database>?driver=ODBC+Driver+18+for+SQL+Server
DB_CONNECTION_STRING=
# BigQuery destination project; falls back to GCP_PROJECT_ID when unset.
# Example: your-data-project
TARGET_PROJECT=
# SQL Server extraction destination dataset; example: bronze
TARGET_DATASET=bronze
# dbt telemetry destination dataset, separate from the extraction dataset.
DBT_TARGET_DATASET=audit_metadata
# dbt project directory, relative to repository root or absolute; example: ./analytics_layer
DBT_PROJECT_DIR=./analytics_layer
# Optional run-results file; defaults to DBT_PROJECT_DIR/target/run_results.json.
# Example: ./analytics_layer/target/run_results.json
DBT_ARTIFACTS_PATH=
# Print pipeline commands without executing ingestion, dbt, or uploads; example: 1
PIPELINE_DRY_RUN=0
